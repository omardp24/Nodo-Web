# Environment variables declared in this file are NOT automatically loaded by Prisma.
# prisma7.config.ts already imports "dotenv/config" so these ARE loaded when running Prisma CLI commands.

# La conexión directa (db.<ref>.supabase.co) es IPv6-only; si tu red no tiene salida
# IPv6, usa el pooler de Supabase (Supavisor), compatible con IPv4. Sacar el host exacto
# (región de AWS) del dashboard: Project Settings → Database → Connection string.
# DATABASE_URL: Transaction pooler (puerto 6543) — la usa la app en runtime.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# DIRECT_URL: Session pooler (puerto 5432) — la usa Prisma solo para migraciones.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase API (no las usa Prisma; SUPABASE_URL/SUPABASE_JWKS_URL las usa el guard de auth) ---
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"

# --- Ingesta de correos (Gmail API OAuth) ---
# Ver CLAUDE.md sección "Ingesta de correos (Gmail)" para los pasos de configuración.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/gmail/callback"
GOOGLE_REFRESH_TOKEN=""

# --- Notificaciones push (Web Push / VAPID) ---
# Generar una sola vez con `npx web-push generate-vapid-keys`. VAPID_PUBLIC_KEY
# también va en el frontend (NEXT_PUBLIC_VAPID_PUBLIC_KEY) — no es secreta.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@ejemplo.com"

# --- Asistente Vínculo (LLM) ---
# Gratis en el tier free de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- CORS (frontend) ---
# Orígenes permitidos separados por coma. Default si no se define: http://localhost:3001
CORS_ORIGIN="http://localhost:3001"
